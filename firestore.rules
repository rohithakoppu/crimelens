rules_version = '2';

// Defense in depth only: the backend is the sole client of Firestore, and it
// always uses the Firebase Admin SDK (a service account), which bypasses
// these rules entirely. The frontend never talks to Firestore directly --
// every read/write goes through the backend's REST API, which enforces its
// own JWT/RBAC checks (see backend/api/deps.py). These rules exist purely
// to guarantee that even if a Firebase web-app config leaked, no one could
// read or write this project's Firestore data directly from a browser.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
