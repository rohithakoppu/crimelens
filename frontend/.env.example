VITE_API_BASE_URL=http://localhost:8000

# Firebase web config -- these are PUBLIC identifiers (safe to ship in a
# frontend bundle by design; Firebase's real security boundary is its
# Security Rules + the backend independently re-verifying every ID token).
# Firebase console -> Project settings -> General -> your web app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
